# Build outputs
build/
out/
*.log

# Local package repo artefacts (regenerated by build-nexus-repo.sh)
localpkgs/repo/
*.pkg.tar.zst
*.pkg.tar.zst.sig
localpkgs/**/nexus.db*
localpkgs/**/nexus.files*

# GPG keyrings and secrets — never publish!
localpkgs/*/gnupg/
**/private-keys-v1.d/
**/openpgp-revocs.d/
**/.gnupg/
nexus-master-key.asc

# makepkg build trees and git clones
localpkgs/*/pkg/
localpkgs/*/src/
localpkgs/nexus-settings/CachyOS-Settings/
localpkgs/nexus-calamares/calamares/
localpkgs/nexus-handheld/CachyOS-Handheld/
localpkgs/nexus-kernel-manager/kernel-manager/
localpkgs/nexus-kernel-manager/cpm-cache/
localpkgs/nexus-mangowc-dms/cachyos-mangowc-dms/
localpkgs/nexus-mangowc-dms/cat-dms/
localpkgs/nexus-micro-settings/cachyos-micro-settings/
localpkgs/nexus-packageinstaller/packageinstaller/
localpkgs/nexus-zsh-config/cachyos-zsh-config/
# Generic makepkg src/pkg but keep rust-workspace
**/src/
!localpkgs/rust-workspace/src/
!localpkgs/rust-workspace/**/src/
!localpkgs/rust-workspace/**/src/**
**/pkg/
!localpkgs/rust-workspace/pkg/
!localpkgs/rust-workspace/**/pkg/

# cloudflare-warp-bin: upstream tree with its own .git + makepkg artefacts
cloudflare-warp-bin/

# Ignore local build clones/symlinks in rust-tools
localpkgs/rust-tools/NexusLinux/
localpkgs/rust-tools/rust-workspace
# Ignore local repo built packages and out
localrepo/*.pkg.tar.zst
localrepo/*.db*
localrepo/*.files*
out/
build/
localpkgs/rust-workspace/target/
.calamares-pkgbuild/
archiso/packages.x86_64.unstable
localpkgs/nexus-keyring/nexus.gpg
localpkgs/nexus-keyring/nexus-revoked
localpkgs/nexus-keyring/nexus-trusted
localpkgs/nexus-keyring/*.pkg.tar.zst
*.pkg.tar.zst.bak linguist-vendored

# airootfs nexus-repo is generated at build time - do not commit stale db
archiso/airootfs/usr/share/nexus-repo/
