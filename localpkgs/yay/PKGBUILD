# Maintainer: Nexus Linux <nexus@nexuslinux.org>
# yay AUR helper, built locally for Nexus ISO (official repos lack yay)
pkgname=yay
pkgver=13.0.1
pkgrel=1
pkgdesc="Yet another yogurt - Pacman wrapper and AUR helper written in go"
arch=('x86_64')
url="https://github.com/Jguer/yay"
license=('GPL-3.0-or-later')
depends=('git' 'pacman')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Jguer/yay/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  export GOFLAGS="-trimpath -mod=readonly"
  go build -o yay .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 yay "$pkgdir/usr/bin/yay"
  # completions and man page if present (do not fail ISO on missing)
  install -Dm644 completions/bash_completion "$pkgdir/usr/share/bash-completion/completions/yay" 2>/dev/null || true
  install -Dm644 completions/zsh_completion "$pkgdir/usr/share/zsh/site-functions/_yay" 2>/dev/null || true
  install -Dm644 completions/fish_completion "$pkgdir/usr/share/fish/vendor_completions.d/yay.fish" 2>/dev/null || true
  install -Dm644 doc/yay.8 "$pkgdir/usr/share/man/man8/yay.8" 2>/dev/null || true
}
