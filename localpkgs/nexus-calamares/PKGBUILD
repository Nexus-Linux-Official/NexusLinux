# Maintainer: Nexus Linux <nexus@nexuslinux.org>
pkgname=nexus-calamares
pkgver=1.0
pkgrel=1
pkgdesc="Nexus Linux Calamares modules, branding, and configuration"
arch=(any)
url="https://github.com/nexuslinux-os/NexusLinux"
license=(GPL-3.0-or-later)
# No depends on calamares - it's built and installed separately as a package
source=(branding.desc
        write-os-release.sh
        shellprocess.conf
        netinstall.yaml
        settings_offline.conf
        kdeglobals
        kwinrc
        plasmarc
        plasma-org.kde.plasma.desktop-appletsrc
        metadata.json)
sha256sums=('SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP'
           'SKIP')

prepare() {
    # Copy only subdirectories not in source array (top-level files already in srcdir via makepkg)
    cp -r "$startdir/colors" "$srcdir/" 2>/dev/null || true
    cp -r "$startdir/fonts" "$srcdir/" 2>/dev/null || true
    cp -r "$startdir/icons" "$srcdir/" 2>/dev/null || true
    cp -r "$startdir/plasma" "$srcdir/" 2>/dev/null || true
    cp -r "$startdir/splash" "$srcdir/" 2>/dev/null || true
    cp -r "$startdir/look-and-feel" "$srcdir/" 2>/dev/null || true
}

package() {
    # Calamares modules
    install -dm755 "$pkgdir/usr/share/nexus-calamares/modules"
    install -m644 netinstall.yaml "$pkgdir/usr/share/nexus-calamares/modules/netinstall.yaml"
    install -m644 settings_offline.conf "$pkgdir/usr/share/nexus-calamares/modules/settings_offline.conf"
    install -m644 shellprocess.conf "$pkgdir/usr/share/nexus-calamares/modules/shellprocess.conf"

    # Write OS release script
    install -m755 write-os-release.sh "$pkgdir/usr/share/nexus-calamares/write-os-release.sh"

    # Shellprocess config
    install -m644 shellprocess.conf "$pkgdir/usr/share/nexus-calamares/modules/shellprocess.conf"

    # Branding directory
    install -dm755 "$pkgdir/usr/share/nexus-calamares/branding/nexus"
    install -m644 branding.desc "$pkgdir/usr/share/nexus-calamares/branding/nexus/branding.desc"

    # Look-and-feel theme "Nexus" for lookandfeeltool (Plasma 6 correct path: look-and-feel)
    # Isolated build: colors are pre-generated files, not derived from host theme
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents"
    install -m644 metadata.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/metadata.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/colors"
    install -m644 colors/BreezeDark.colors "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/colors/BreezeDark.colors"
    install -m644 colors/BreezeLight.colors "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/colors/BreezeLight.colors"
    install -m644 colors/BreezeTwilight.colors "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/colors/BreezeTwilight.colors"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/fonts"
    install -m644 fonts/fonts.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/fonts/fonts.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/icons"
    install -m644 icons/icons.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/icons/icons.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/plasma"
    install -m644 plasma/desktoptheme.json "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/plasma/desktoptheme.json"
    install -dm755 "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/splash"
    install -m644 splash/Splash.qml "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/splash/Splash.qml"
    # Also provide defaults file so plasma-apply-lookandfeel picks wallpaper/icons correctly
    if [ -f "$srcdir/look-and-feel/nexus/contents/defaults" ]; then
        install -Dm644 "$srcdir/look-and-feel/nexus/contents/defaults" "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/defaults"
    else
        # fallback defaults generated from nexus-skel defaults (icons/cursor/wallpaper)
        install -Dm644 /dev/stdin "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents/defaults" <<'DEFAULTS_EOF'
[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kdeglobals][General]
ColorScheme=BreezeDark

[kdeglobals][Icons]
Theme=breeze-dark

[plasmarc][Theme]
name=breeze-dark

[Wallpaper]
Image=file:///usr/share/wallpapers/nexus/contents/images_dark/3840x2160.png

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[ksplashrc][KSplash]
Theme=org.kde.breezedark.desktop
DEFAULTS_EOF
    fi

    # Legacy compat: Plasma 5 used lookandfeel (no hyphen) – keep a symlink/copy for older tools
    install -dm755 "$pkgdir/usr/share/plasma/lookandfeel/Nexus/contents"
    cp -a "$pkgdir/usr/share/plasma/look-and-feel/nexus/contents"/* "$pkgdir/usr/share/plasma/lookandfeel/Nexus/contents/"
    cp -a "$pkgdir/usr/share/plasma/look-and-feel/nexus/metadata.json" "$pkgdir/usr/share/plasma/lookandfeel/Nexus/metadata.json"
}