post_install() {
    # Initialize pacman keyring if needed
    if [[ ! -d /etc/pacman.d/gnupg ]]; then
        pacman-key --init
    fi

    # Populate BOTH keyrings. `--populate nexus` imports nexus.gpg AND
    # locally signs the fingerprint listed in nexus-trusted (':4:' = fully
    # trusted). Never use bare `pacman-key --add` here: an added-but-unsigned
    # key cannot verify packages under `SigLevel = Required`, which is exactly
    # what broke the [nexus] repo on the live ISO / installed systems.
    pacman-key --populate nexus archlinux
}

post_upgrade() {
    post_install
}

post_remove() {
    # Keep the key on removal to avoid breaking installed systems
    true
}
